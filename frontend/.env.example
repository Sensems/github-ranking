# Copy to .env and fill in real values. Do not commit .env.

# Postgres (required for leaderboard APIs)
NUXT_DATABASE_URL=postgresql://nuxt_app:YOUR_PASSWORD@127.0.0.1:5432/github-ranking

# Optional: on-demand AI summary (RepoCard button)
# NUXT_XFYUN_API_KEY=
# NUXT_XFYUN_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1/
# NUXT_XFYUN_MODEL=spark-x

# Optional public site URL (sitemap / SEO)
# SITE_URL=https://github-trend.example.com
